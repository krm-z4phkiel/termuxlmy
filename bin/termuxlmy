#!/bin/bash
# 🧠 termuxlmy - Local Memory for You
# Version: 1.1.0

set -euo pipefail

MEMORY_DIR="$HOME/.hermes/memories"
DB_PATH="$HOME/.hermes/memory_store.db"
DB_ENC_PATH="$HOME/.hermes/memory_store.db.enc"
SCRIPTS_DIR="$HOME/.hermes/scripts"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ==========================================
# Input Validation
# ==========================================

validate_input() {
    local input="$1"
    local max_len=1000
    
    # Check length
    if [ ${#input} -gt $max_len ]; then
        echo -e "${RED}❌ Input too long (max $max_len chars)${NC}"
        return 1
    fi
    
    # Check for dangerous patterns
    if echo "$input" | grep -qiE "(DROP|DELETE|TRUNCATE|ALTER|CREATE|INSERT.*INTO.*SELECT)"; then
        echo -e "${YELLOW}⚠️  Warning: SQL keywords detected in input${NC}"
        echo "Input will be stored as plain text."
    fi
    
    return 0
}

# ==========================================
# Database Operations
# ==========================================

init_db() {
    mkdir -p "$HOME/.hermes"
    
    python3 << 'PYEOF'
import sqlite3, os

DB = os.path.expanduser("~/.hermes/memory_store.db")
conn = sqlite3.connect(DB)
c = conn.cursor()

c.execute("""CREATE TABLE IF NOT EXISTS facts (
    fact_id INTEGER PRIMARY KEY AUTOINCREMENT,
    content TEXT NOT NULL,
    category TEXT DEFAULT 'general',
    tags TEXT,
    trust_score REAL DEFAULT 0.5,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)""")

c.execute("""CREATE TABLE IF NOT EXISTS entities (
    entity_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    entity_type TEXT,
    aliases TEXT
)""")

c.execute("""CREATE TABLE IF NOT EXISTS fact_entities (
    fact_id INTEGER,
    entity_id INTEGER,
    FOREIGN KEY (fact_id) REFERENCES facts(fact_id),
    FOREIGN KEY (entity_id) REFERENCES entities(entity_id)
)""")

# Create FTS5 index for full-text search
c.execute("""CREATE VIRTUAL TABLE IF NOT EXISTS facts_fts 
    USING fts5(content, category, tags)""")

conn.commit()
conn.close()
print("✅ Database initialized!")
PYEOF
}

# ==========================================
# Encryption Functions
# ==========================================

encrypt_db() {
    local password="$1"
    
    if [ ! -f "$DB_PATH" ]; then
        echo -e "${RED}❌ Database not found. Run: termuxlmy setup${NC}"
        return 1
    fi
    
    openssl enc -aes-256-cbc -salt -pbkdf2 \
        -in "$DB_PATH" \
        -out "$DB_ENC_PATH" \
        -pass pass:"$password" 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ Database encrypted!${NC}"
        echo "Encrypted file: $DB_ENC_PATH"
        echo -e "${YELLOW}⚠️  Original database still exists. Remove with: rm $DB_PATH${NC}"
    else
        echo -e "${RED}❌ Encryption failed${NC}"
        return 1
    fi
}

decrypt_db() {
    local password="$1"
    
    if [ ! -f "$DB_ENC_PATH" ]; then
        echo -e "${RED}❌ Encrypted database not found${NC}"
        return 1
    fi
    
    openssl enc -aes-256-cbc -d -salt -pbkdf2 \
        -in "$DB_ENC_PATH" \
        -out "$DB_PATH" \
        -pass pass:"$password" 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ Database decrypted!${NC}"
    else
        echo -e "${RED}❌ Decryption failed (wrong password?)${NC}"
        return 1
    fi
}

# ==========================================
# Backup Functions
# ==========================================

backup_to_github() {
    local repo_dir="$HOME/.termuxlmy-backup"
    local token_file="$HOME/.hermes/github_token"
    
    # Check if token exists
    if [ ! -f "$token_file" ]; then
        echo -e "${RED}❌ GitHub token not found${NC}"
        echo "Run: termuxlmy setup-backup"
        return 1
    fi
    
    local token=$(cat "$token_file")
    local timestamp=$(date '+%Y-%m-%d %H:%M')
    
    # Create backup directory
    mkdir -p "$repo_dir/memories"
    mkdir -p "$repo_dir/database"
    
    # Copy files
    cp "$MEMORY_DIR/"*.md "$repo_dir/memories/" 2>/dev/null || true
    cp -r "$MEMORY_DIR/Sessions/" "$repo_dir/memories/" 2>/dev/null || true
    
    # Encrypt and copy database
    if [ -f "$DB_PATH" ]; then
        cp "$DB_PATH" "$repo_dir/database/"
    fi
    
    # Git operations
    cd "$repo_dir"
    
    if [ ! -d ".git" ]; then
        git init
        git remote add origin "https://$token@github.com/krm-z4phkiel/termuxlmy-backup.git" 2>/dev/null || true
    fi
    
    git add -A
    if ! git diff --cached --quiet; then
        git commit -m "🔄 Auto-backup: $timestamp" 2>/dev/null
        git push origin main 2>/dev/null
        echo -e "${GREEN}✅ Backup pushed to GitHub!${NC}"
    else
        echo -e "${YELLOW}ℹ️  No changes to backup${NC}"
    fi
}

setup_backup() {
    echo "🔧 Setting up GitHub backup..."
    echo ""
    
    # Get token
    read -p "GitHub Token (ghp_xxxxx): " token
    
    if [ -z "$token" ]; then
        echo -e "${RED}❌ Token cannot be empty${NC}"
        return 1
    fi
    
    # Save token securely
    mkdir -p "$HOME/.hermes"
    echo "$token" > "$HOME/.hermes/github_token"
    chmod 600 "$HOME/.hermes/github_token"
    
    echo -e "${GREEN}✅ Token saved securely${NC}"
    echo "Location: ~/.hermes/github_token (mode 600)"
    
    # Create backup repo if needed
    local repo_dir="$HOME/.termuxlmy-backup"
    if [ ! -d "$repo_dir/.git" ]; then
        mkdir -p "$repo_dir"
        cd "$repo_dir"
        git init
        git remote add origin "https://$token@github.com/krm-z4phkiel/termuxlmy-backup.git" 2>/dev/null || true
        echo -e "${GREEN}✅ Backup repo initialized${NC}"
    fi
}

# ==========================================
# Main Commands
# ==========================================

case "${1:-help}" in
    setup)
        echo "🧠 Setting up termuxlmy..."
        mkdir -p "$MEMORY_DIR/Sessions"
        mkdir -p "$SCRIPTS_DIR"
        
        # Initialize database
        init_db
        
        # Create MEMORY.md if not exists
        if [ ! -f "$MEMORY_DIR/MEMORY.md" ]; then
            cat > "$MEMORY_DIR/MEMORY.md" << 'MEMEOF'
# 🧠 Memory Hub

> Central memory — semua ingatan saling terhubung

## 👤 User
- Nama: [nama kamu]
- Preferensi: [yang kamu suka]

## 🔧 Tools
- [tools yang kamu pakai]

## 📝 Catatan
- [fakta penting]
MEMEOF
            echo -e "${GREEN}✅ MEMORY.md created${NC}"
        fi
        
        echo ""
        echo -e "${GREEN}✅ Setup complete!${NC}"
        echo "Run: termuxlmy status"
        ;;
    
    status)
        echo "🧠 termuxlmy Status v1.1.0"
        echo "├── Memory: $(ls "$MEMORY_DIR"/*.md 2>/dev/null | wc -l) files"
        echo "├── Sessions: $(ls "$MEMORY_DIR/Sessions/"*.md 2>/dev/null | wc -l) logs"
        if [ -f "$DB_PATH" ]; then
            SIZE=$(ls -la "$DB_PATH" | awk '{print $5}')
            FACTS=$(python3 -c "import sqlite3; conn=sqlite3.connect('$DB_PATH'); print(conn.execute('SELECT COUNT(*) FROM facts').fetchone()[0])" 2>/dev/null || echo "0")
            ENTITIES=$(python3 -c "import sqlite3; conn=sqlite3.connect('$DB_PATH'); print(conn.execute('SELECT COUNT(*) FROM entities').fetchone()[0])" 2>/dev/null || echo "0")
            echo "├── Database: ${SIZE:-0} bytes"
            echo "├── Facts: ${FACTS:-0}"
            echo "├── Entities: ${ENTITIES:-0}"
        else
            echo "├── Database: Not initialized (run termuxlmy setup)"
        fi
        echo "├── Encrypted: $([ -f "$DB_ENC_PATH" ] && echo 'Yes' || echo 'No')"
        echo "└── Backup: $([ -f "$HOME/.hermes/github_token" ] && echo 'Configured' || echo 'Not configured')"
        ;;
    
    add)
        shift
        CONTENT="$*"
        if [ -z "$CONTENT" ]; then
            echo "Usage: termuxlmy add <text>"
            exit 1
        fi
        
        # Validate input
        validate_input "$CONTENT" || exit 1
        
        python3 << PYEOF
import sqlite3, os
DB = os.path.expanduser('~/.hermes/memory_store.db')
conn = sqlite3.connect(DB)
c = conn.cursor()
# Parameterized query - safe from SQL injection
c.execute('INSERT INTO facts (content, category) VALUES (?, ?)', ('${CONTENT//\'/\'\'}', 'manual'))
conn.commit()
conn.close()
print('✅ Added: ${CONTENT}')
PYEOF
        ;;
    
    search)
        shift
        QUERY="$*"
        if [ -z "$QUERY" ]; then
            echo "Usage: termuxlmy search <query>"
            exit 1
        fi
        
        python3 << PYEOF
import sqlite3, os
DB = os.path.expanduser('~/.hermes/memory_store.db')
conn = sqlite3.connect(DB)
c = conn.cursor()
# Parameterized query - safe from SQL injection
c.execute('SELECT content, category, trust_score FROM facts WHERE content LIKE ?', ('%${QUERY//\'/\'\'}%',))
results = c.fetchall()
if results:
    for row in results:
        print(f'[{row[1]}] {row[0]} (trust: {row[2]})')
else:
    print('No results found')
conn.close()
PYEOF
        ;;
    
    encrypt)
        read -s -p "Enter encryption password: " password
        echo ""
        encrypt_db "$password"
        ;;
    
    decrypt)
        read -s -p "Enter decryption password: " password
        echo ""
        decrypt_db "$password"
        ;;
    
    backup)
        backup_to_github
        ;;
    
    setup-backup)
        setup_backup
        ;;
    
    test)
        echo "🧪 Running termuxlmy tests..."
        echo ""
        
        # Test 1: Database initialization
        echo "Test 1: Database initialization..."
        init_db > /dev/null 2>&1
        if [ -f "$DB_PATH" ]; then
            echo -e "  ${GREEN}✅ PASS${NC}"
        else
            echo -e "  ${RED}❌ FAIL${NC}"
        fi
        
        # Test 2: Add fact
        echo "Test 2: Add fact..."
        python3 -c "
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
c.execute('INSERT INTO facts (content, category) VALUES (?, ?)', ('test fact', 'test'))
conn.commit()
count = conn.execute('SELECT COUNT(*) FROM facts').fetchone()[0]
conn.close()
print('  ✅ PASS' if count > 0 else '  ❌ FAIL')
"
        
        # Test 3: Search fact
        echo "Test 3: Search fact..."
        python3 -c "
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
c.execute('SELECT content FROM facts WHERE content LIKE ?', ('%test%',))
result = c.fetchone()
conn.close()
print('  ✅ PASS' if result else '  ❌ FAIL')
"
        
        # Test 4: SQL injection prevention
        echo "Test 4: SQL injection prevention..."
        python3 -c "
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
try:
    c.execute('INSERT INTO facts (content, category) VALUES (?, ?)', (\"test'; DROP TABLE facts--\", 'test'))
    conn.commit()
    # Check if table still exists
    c.execute('SELECT COUNT(*) FROM facts')
    conn.close()
    print('  ✅ PASS (table intact)')
except:
    print('  ❌ FAIL')
"
        
        # Test 5: Input validation
        echo "Test 5: Input validation..."
        long_input=$(python3 -c "print('x' * 2000)")
        if validate_input "$long_input" 2>/dev/null; then
            echo "  ❌ FAIL (should reject long input)"
        else
            echo "  ✅ PASS (long input rejected)"
        fi
        
        # Cleanup test data
        python3 -c "
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
c.execute(\"DELETE FROM facts WHERE category = 'test'\")
conn.commit()
conn.close()
"
        
        echo ""
        echo "🧪 Tests complete!"
        ;;
    
    help|--help|-h)
        # Non-interactive fallback: show help text
        if [[ ! -t 0 ]]; then
            echo "🧠 termuxlmy - Local Memory for You v1.1.0"
            echo ""
            echo "Commands:"
            echo "  termuxlmy setup          — Initialize memory system"
            echo "  termuxlmy status         — Check status"
            echo "  termuxlmy add <text>     — Add a fact"
            echo "  termuxlmy search <query> — Search facts"
            echo "  termuxlmy encrypt        — Encrypt database"
            echo "  termuxlmy decrypt        — Decrypt database"
            echo "  termuxlmy backup         — Backup to GitHub"
            echo "  termuxlmy setup-backup   — Setup GitHub backup"
            echo "  termuxlmy test           — Run tests"
            echo "  termuxlmy help           — Show this help"
            exit 0
        fi

        # Interactive menu
        while true; do
            echo ""
            echo -e "🧠 ${GREEN}termuxlmy${NC} - Local Memory for You v1.1.0"
            echo ""
            echo "  1. Setup           — Initialize memory system"
            echo "  2. Status          — Check status"
            echo "  3. Add             — Add a fact"
            echo "  4. Search          — Search facts"
            echo "  5. Encrypt         — Encrypt database"
            echo "  6. Decrypt         — Decrypt database"
            echo "  7. Backup          — Backup to GitHub"
            echo "  8. Setup Backup    — Setup GitHub backup"
            echo "  9. Test            — Run tests"
            echo "  0. Exit"
            echo ""
            read -p "  Pilih [1-9/0]: " choice
            echo ""

            case "$choice" in
                1) bash "$0" setup ;;
                2) bash "$0" status ;;
                3)
                    read -p "  Teks (0=cancel): " text
                    [ "$text" = "0" ] && continue
                    if [ -n "$text" ]; then
                        bash "$0" add "$text"
                    else
                        echo -e "  ${RED}❌ Teks tidak boleh kosong${NC}"
                    fi
                    ;;
                4)
                    read -p "  Query (0=cancel): " query
                    [ "$query" = "0" ] && continue
                    if [ -n "$query" ]; then
                        bash "$0" search "$query"
                    else
                        echo -e "  ${RED}❌ Query tidak boleh kosong${NC}"
                    fi
                    ;;
                5)
                    read -p "  Password (0=cancel): " -s pass
                    echo ""
                    [ "$pass" = "0" ] && continue
                    bash "$0" encrypt <<< "$pass"
                    ;;
                6)
                    read -p "  Password (0=cancel): " -s pass
                    echo ""
                    [ "$pass" = "0" ] && continue
                    bash "$0" decrypt <<< "$pass"
                    ;;
                7) bash "$0" backup ;;
                8) bash "$0" setup-backup ;;
                9) bash "$0" test ;;
                0) echo "🐦‍⬛ Goodbye!"; exit 0 ;;
                *) echo -e "  ${RED}❌ Pilihan tidak valid: $choice${NC}" ;;
            esac
        done
        ;;

    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run: termuxlmy help"
        exit 1
        ;;
esac
